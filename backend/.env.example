# ── App ──
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ── Database ──
DATABASE_URL=postgresql://vella:vella_dev_password@localhost:5433/vella_market?schema=public

# ── Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ──
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_HMAC_SECRET=change-me-otp-secret-min-32-chars-long

# ── OTP policy ──
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5

# ── Email (EMAIL_PROVIDER=smtp for local Mailpit, resend for production) ──
EMAIL_PROVIDER=smtp
EMAIL_FROM="Vella Market <no-reply@vellamarket.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# ── SMS (SMS_PROVIDER=console is development-only and logs a notice, never the code) ──
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Payments (Flutterwave sandbox) ──
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# ── Seed (development only) ──
SEED_ADMIN_EMAIL=admin@vellamarket.local
SEED_ADMIN_PASSWORD=ChangeMe!12345
